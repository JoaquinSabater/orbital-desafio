# Copiar este archivo como .env y completar los valores.
# El .env real no se versiona (está en .gitignore).

# Servidor HTTP
PORT=3001

# Origen permitido por CORS (URL del frontend de Vite)
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=orbital
DB_CONNECTION_LIMIT=10
